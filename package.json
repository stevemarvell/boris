{
  "name": "linkjar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small bookmarks service used as a practice ground for scaling agentic development.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test test/**/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "start": "tsx src/http/server.ts",
    "cli": "tsx src/cli/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
