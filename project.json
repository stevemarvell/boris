{
  "$comment": "The one place the AI layer (.claude/, scripts/, .github/) learns about the application (#173). Swap the app by editing apps/ and this file. scripts/project.mjs reads and validates it; its tests pin the shape.",
  "name": "family-tree",
  "vercel": {
    "team": "stevemarvell-team"
  },
  "apps": {
    "api": {
      "path": "apps/api",
      "toolchain": "python",
      "vercelProject": "family-tree-api",
      "url": "https://family-tree-api-stevemarvell-team.vercel.app",
      "commitEndpoint": "/health",
      "smoke": "apps/api/smoke.sh",
      "reads": ["apps/api"],
      "ignores": ["apps/api/smoke.sh"]
    },
    "web": {
      "path": "apps/web",
      "toolchain": "node",
      "vercelProject": "family-tree-web",
      "url": "https://family-tree-web-eta.vercel.app",
      "commitEndpoint": "/docs/version.json",
      "smoke": "apps/web/smoke.sh",
      "reads": [
        "apps/web",
        "docs",
        "manual/web",
        "index.html",
        "package.json",
        "package-lock.json",
        "scripts/markdown.mjs"
      ],
      "ignores": [
        "apps/web/smoke.sh",
        "apps/web/e2e",
        "**/*.test.ts",
        "**/*.test.tsx"
      ]
    },
    "mcp": {
      "path": "apps/mcp",
      "toolchain": "python",
      "reads": [
        "apps/mcp",
        "apps/api"
      ]
    }
  }
}
