.idea

# Agent worktrees live inside the repo; they are not content.
.claude/worktrees/

# node
.env*.local
node_modules/
dist/
.vercel/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
test-results/
playwright-report/

# Seeded design canvases are ~2.5MB and regenerate from the .dc.html sources.
design/*.html
!design/*.dc.html

# Local secrets — telemetry/.env holds the Grafana admin password. The
# committed apps/web/.env.production is a public URL and is deliberately not
# matched by this.
.env

# Written by scripts/write-ci-telemetry-settings.mjs on a runner, and by
# anyone overriding project settings locally. Never committed.
.claude/settings.local.json

# Built by scripts/build-docs.mjs on every web build. Vite copies it into the
# bundle; it is output, not content.
apps/web/public/
